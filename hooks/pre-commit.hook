#!/bin/sh
# pre-commit hook: check staged C source formatting with uncrustify
# Skip with: git commit -n

REPO_ROOT=$(git rev-parse --show-toplevel) || exit 1
CONFIG="$REPO_ROOT/tools/uncrustify.cfg"

FILES=$(mktemp) || exit 1
INPUT=
OUTPUT=
trap 'rm -f "$FILES" "$INPUT" "$OUTPUT"' EXIT HUP INT TERM

# Determine whether formatting is needed before checking the dependency or config.
git diff --cached --name-only --diff-filter=ACM -- '*.c' '*.h' > "$FILES" ||
  exit 1
if [ ! -s "$FILES" ]; then
  exit 0
fi

if ! command -v uncrustify > /dev/null 2>&1; then
  echo "uncrustify not found in PATH" >&2
  exit 1
fi

if [ ! -f "$CONFIG" ]; then
  echo "uncrustify config not found at $CONFIG" >&2
  exit 1
fi

ERRORS=
while IFS= read -r f; do
  INPUT=$(mktemp) || exit 1
  OUTPUT=$(mktemp) || exit 1

  if ! git show ":$f" > "$INPUT"; then
    echo "Unable to read staged file: $f" >&2
    exit 1
  fi

  if ! uncrustify -q -c "$CONFIG" -l C -f "$INPUT" -o "$OUTPUT"; then
    echo "uncrustify failed while formatting staged file: $f" >&2
    exit 1
  fi

  if ! diff -q "$INPUT" "$OUTPUT" > /dev/null 2>&1; then
    ERRORS="${ERRORS}
  $f"
  fi

  rm -f "$INPUT" "$OUTPUT"
  INPUT=
  OUTPUT=
done < "$FILES"

if [ -n "$ERRORS" ]; then
  echo "Code style error in:$ERRORS"
  echo ""
  echo "Fix with: uncrustify -c tools/uncrustify.cfg -l C --replace <file>"
  echo "Then stage only the intended formatting hunks (for example: git add -p)."
  exit 1
fi

exit 0
