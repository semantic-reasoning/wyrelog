#!/bin/sh
# wyrelog code style formatter (based on GStreamer's gst-indent).

EXPECTED_VERSION="GNU indent 2.2.13"
INDENT=
FOUND_VERSIONS=

for candidate in gnuindent gindent indent; do
  if ! command -v "$candidate" > /dev/null 2>&1; then
    continue
  fi

  version=$("$candidate" --version 2>&1 | head -1)
  if [ "$version" = "$EXPECTED_VERSION" ]; then
    INDENT=$candidate
    break
  fi

  case "$version" in
    *GNU\ indent*)
      FOUND_VERSIONS="${FOUND_VERSIONS}
  $candidate: $version"
      ;;
  esac
done

if [ -z "$INDENT" ]; then
  if [ -n "$FOUND_VERSIONS" ]; then
    echo "format: GNU indent 2.2.13 is required; incompatible versions found:$FOUND_VERSIONS" >&2
  else
    echo "format: GNU indent 2.2.13 is required but was not found in PATH" >&2
  fi
  echo "format: run tools/install-gnu-indent.sh <absolute-prefix> or install gnu-indent 2.2.13" >&2
  exit 1
fi

if [ "${1-}" = "--check-version" ]; then
  if [ "$#" -ne 1 ]; then
    echo "usage: tools/gst-indent --check-version" >&2
    exit 2
  fi
  echo "$EXPECTED_VERSION"
  exit 0
fi

for f in "$@"; do
  if [ ! -f "$f" ]; then
    echo "format: input is not a regular file: $f" >&2
    exit 1
  fi

  "$INDENT" \
    --braces-on-if-line \
    --case-brace-indentation0 \
    --case-indentation2 \
    --braces-after-struct-decl-line \
    --line-length80 \
    --no-tabs \
    --cuddle-else \
    --dont-line-up-parentheses \
    --continuation-indentation4 \
    --honour-newlines \
    --tab-size8 \
    --indent-level2 \
    --leave-preprocessor-space \
    "$f" || exit $?

  "$INDENT" \
    --braces-on-if-line \
    --case-brace-indentation0 \
    --case-indentation2 \
    --braces-after-struct-decl-line \
    --line-length80 \
    --no-tabs \
    --cuddle-else \
    --dont-line-up-parentheses \
    --continuation-indentation4 \
    --honour-newlines \
    --tab-size8 \
    --indent-level2 \
    --leave-preprocessor-space \
    "$f" || exit $?
done
