diff --git a/src/include/duckdb/common/bit_utils.hpp b/src/include/duckdb/common/bit_utils.hpp
index 23b99ee3..060acd89 100644
--- a/src/include/duckdb/common/bit_utils.hpp
+++ b/src/include/duckdb/common/bit_utils.hpp
@@ -42,7 +42,17 @@ struct CountZeros<uint64_t> {
 		value |= value >> 32;
 		auto result = 63 - index64msb[(value * debruijn64msb) >> 58];
 #ifdef __clang__
-		D_ASSERT(result == static_cast<uint64_t>(__builtin_clzl(value_in)));
+		// __builtin_clzl and __builtin_ctzl take unsigned long: 64-bit under
+		// LP64, but 32-bit under LLP64 (clang-cl on Windows).  There the
+		// argument is truncated, so neither is a valid oracle for a uint64_t
+		// and both fire on a correct de Bruijn result -- Leading for any value
+		// with a bit set above 32, Trailing for any whose low 32 bits are all
+		// zero, where the truncated argument is zero and tzcnt answers 32.
+		//
+		// The ll forms take unsigned long long, 64-bit under both data models,
+		// so they oracle what these functions actually compute.  The
+		// computations are unchanged; only the debug cross-checks move.
+		D_ASSERT(result == static_cast<uint64_t>(__builtin_clzll(value_in)));
 #endif
 		return result;
 	}
@@ -59,7 +69,7 @@ struct CountZeros<uint64_t> {
 		constexpr uint64_t debruijn64lsb = 0x07EDD5E59A4E28C2ULL;
 		auto result = index64lsb[((value & -value) * debruijn64lsb) >> 58];
 #ifdef __clang__
-		D_ASSERT(result == static_cast<uint64_t>(__builtin_ctzl(value_in)));
+		D_ASSERT(result == static_cast<uint64_t>(__builtin_ctzll(value_in)));
 #endif
 		return result;
 	}
