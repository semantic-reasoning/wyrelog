+static bool TryGetConfiguredHomeDirectory(optional_ptr<FileOpener> opener, string &home_directory) {
+	if (!opener) {
+		return false;
+	}
+	Value result;
+	if (!opener->TryGetCurrentSetting("home_directory", result) || result.IsNull() || result.ToString().empty()) {
+		return false;
+	}
+	home_directory = result.ToString();
+	return true;
+}
